# SMTP для отправки кодов 2FA на email
# Если SMTP_HOST не задан — код печатается в лог (режим отладки)

# --- Яндекс ---
# SMTP_HOST=smtp.yandex.ru
# SMTP_USERNAME=ваш-логин@yandex.ru
# SMTP_PASSWORD=пароль-приложения
# SMTP_FROM=ваш-логин@yandex.ru

# --- Gmail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=ваш-логин@gmail.com
# SMTP_PASSWORD=пароль-приложения (не обычный пароль!)
# SMTP_FROM=ваш-логин@gmail.com

# --- Mail.ru ---
# SMTP_HOST=smtp.mail.ru
# SMTP_USERNAME=ваш-логин@mail.ru
# SMTP_PASSWORD=пароль-приложения
# SMTP_FROM=ваш-логин@mail.ru
