# База данных
DATABASE_URL=postgres://user:password@localhost:5432/game?sslmode=disable

# JWT подпись (обязательно смени на свою! Минимум 32 символа)
# Сгенерируй: openssl rand -hex 32
JWT_SECRET=

# SMTP для отправки кодов 2FA на email
